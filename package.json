{
  "name": "clubpulse",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm run dev -w server' 'npm run dev -w client'",
    "dev:db": "npm run dev:db -w server",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "admin:create": "npm run admin:create -w server",
    "seed:events": "npm run seed:events -w server",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  }
}
