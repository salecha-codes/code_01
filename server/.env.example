NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/clubpulse
# Required: generate a random secret of at least 32 characters.
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=lax
# Only needed when running npm run admin:create. Never use example credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional local-only tooling (never needed on Render):
# MONGOMS_SYSTEM_BINARY=/absolute/path/to/a/verified/mongod
# MONGOMS_DOWNLOAD_DIR=/absolute/path/to/binary-cache
# CLUBPULSE_DB_PATH=/absolute/path/to/local-database-files
